# Gemini powers the explicit research graph.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MODEL_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=30
WORKER_SHUTDOWN_GRACE_SECONDS=10

# PostgreSQL stores conversation records and LangGraph checkpoints.
DATABASE_URL=postgresql://minialpha:minialpha@localhost:5433/minialpha

# Redis Streams retain reconnectable run events for one day by default.
REDIS_URL=redis://localhost:6379/0
RUN_EVENT_RETENTION_SECONDS=86400
SSE_KEEPALIVE_SECONDS=15

# Complete successful stateless results use Redis exact caching and optional
# Gemini-embedding/pgvector semantic caching. Threaded turns always bypass it.
RESEARCH_CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
CACHE_POLICY_VERSION=1
CACHE_GRAPH_VERSION=1
CACHE_TOOL_SCHEMA_VERSION=1
CACHE_EMBEDDING_MODEL=models/gemini-embedding-001
CACHE_EMBEDDING_DIMENSIONS=768
CACHE_SEMANTIC_THRESHOLD=0.92
CACHE_MAX_PAYLOAD_BYTES=1000000
CACHE_FILL_LOCK_SECONDS=30
CACHE_FILL_WAIT_SECONDS=30

# LangSmith tracing is opt-in and privacy-redacted. MiniAlpha custom spans send
# empty inputs/outputs plus bounded operational metadata only.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=mini-alpha-local
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_TRACING_SAMPLING_RATE=1.0
