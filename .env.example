# Gemini powers the explicit research graph.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MODEL_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=30
WORKER_SHUTDOWN_GRACE_SECONDS=10

# PostgreSQL stores conversation records and LangGraph checkpoints.
DATABASE_URL=postgresql://minialpha:minialpha@localhost:5433/minialpha
